@article{Kechagia2015,
	title = {Extrapolation of enalapril efficacy from adults to children using pharmacokinetic/pharmacodynamic modelling.},
	volume = {67},
	rights = {© 2015 Royal Pharmaceutical Society.},
	issn = {2042-7158 0022-3573},
	doi = {10.1111/jphp.12471},
	abstract = {{OBJECTIVES}: To extrapolate enalapril efficacy to children 0-6 years old, a pharmacokinetic/pharmacodynamic ({PKPD}) model was built using literature data,  with blood pressure as the {PD} endpoint. {METHODS}: A {PK} model of enalapril was  developed from literature paediatric data up to 16 years old. A {PD} model of  enalapril was fitted to adult literature response vs time data with various  doses. The final {PKPD} model was validated with literature paediatric efficacy  observations (diastolic blood pressure ({DBP}) drop after 2 weeks of treatment) in  children of age 6 years and higher. The model was used to predict enalapril  efficacy for ages 0-6 years. {KEY} {FINDINGS}: A two-compartment {PK} model was chosen  with weight, reflecting indirectly age as a covariate on clearance and central  volume. An indirect link {PD} model was chosen to describe drug effect. External  validation of the model's capability to predict efficacy in children was  successful. Enalapril efficacy was extrapolated to ages 1-11 months and 1-6 years  finding the mean {DBP} drop 11.2 and 11.79 {mmHg}, respectively. {CONCLUSIONS}:  Mathematical modelling was used to extrapolate enalapril efficacy to young  children to support a paediatric investigation plan targeting a paediatric-use  marketing authorization application.},
	pages = {1537--1545},
	number = {11},
	journaltitle = {The Journal of pharmacy and pharmacology},
	shortjournal = {J Pharm Pharmacol},
	author = {Kechagia, Irene-Ariadne and Kalantzi, Lida and Dokoumetzidis, Aristides},
	date = {2015-11},
	note = {Place: England},
	keywords = {Adolescent, Adult, checked:{SP}, data:pharmacokinetics, data:timecourse, Humans, Male, species:human, Aged, checked:{MK}, data:pharmacodynamics, Dose-Response Relationship, Drug, Female, enalapril, Middle Aged, priority:no, Blood Pressure/*drug effects, Child, Infant, *Models, Biological, Child, Preschool, Age Factors, Angiotensin-Converting Enzyme Inhibitors/*administration \& dosage/pharmacokinetics/pharmacology, Enalapril/*administration \& dosage/pharmacokinetics/pharmacology, paediatric investigation plan, pharmacokinetic/pharmacodynamic extrapolation},
	file = {Kechagia et al. - 2015 - Extrapolation of enalapril efficacy from adults to.pdf:/home/shubhankar/Zotero/storage/M3UIYCZJ/Kechagia et al. - 2015 - Extrapolation of enalapril efficacy from adults to.pdf:application/pdf},
