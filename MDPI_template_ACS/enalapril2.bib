@article{Landis2013,
	title = {Physicochemical property trends of marketed prodrugs.},
	volume = {4},
	issn = {2041-5990},
	doi = {10.4155/tde.12.150},
	abstract = {Many prodrug reviews describe specific examples of the successful application of prodrug technology to produce blockbuster drugs, such as simvastatin, omeprazole,  acyclovir and enalapril. These reviews are helpful to understand the previous  success stories and case histories of prodrug technology. The aim of the current  review seeks to more clearly define quantitative trends in the changes in the  physicochemical property parameters between the successful prodrug and the active  parent molecule. This information can serve to guide medicinal chemists toward  more successful pharmaceutical prodrugs in the future.},
	pages = {225--237},
	number = {2},
