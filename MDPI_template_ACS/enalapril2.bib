	file = {Thongnopnua and Poeaknapo - 2005 - High-performance liquid chromatographic determinat.pdf:/home/shubhankar/Zotero/storage/9IRWVK9E/Thongnopnua and Poeaknapo - 2005 - High-performance liquid chromatographic determinat.pdf:application/pdf},
