	shortjournal = {Am J Physiol Gastrointest Liver Physiol},
	author = {Liu, Lichuan and Sun, Huadong and Valji, Wiqas Y. and Pang, K. Sandy},
	date = {2007-11},
	note = {Place: United States},
	keywords = {checked:{SP}, Male, Animals, Rats, priority:no, Rats, Inbred Strains, Enalapril/*pharmacokinetics, Enzymes/*metabolism, Liver Neoplasms/pathology/*physiopathology, Neoplasm Metastasis/pathology/*physiopathology, Neoplasm Proteins/*metabolism},
	file = {Liu et al. - 2007 - Transporters, enzymes, and enalapril removal in a .pdf:/home/shubhankar/Zotero/storage/49CMIT25/Liu et al. - 2007 - Transporters, enzymes, and enalapril removal in a .pdf:application/pdf},
