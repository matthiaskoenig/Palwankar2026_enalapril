	file = {Narita et al. - 1999 - Effects of short-term glycemic control, low protei.pdf:/home/shubhankar/Zotero/storage/7WP7FSUS/Narita et al. - 1999 - Effects of short-term glycemic control, low protei.pdf:application/pdf},
