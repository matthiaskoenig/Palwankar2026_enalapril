	note = {Place: England},
	keywords = {Adult, Humans, Male, Aged, Blood Pressure/drug effects, Female, Middle Aged, Lisinopril, Creatine/blood, Peptidyl-Dipeptidase A/metabolism, Pulse/drug effects, Angiotensin-Converting Enzyme Inhibitors/*pharmacokinetics/therapeutic use, Enalapril/*analogs \& derivatives/blood/pharmacokinetics/therapeutic use, Kidney Failure, Chronic/drug therapy/*metabolism, Proteinuria/urine},
	file = {Jackson et al. - 1988 - Lisinopril pharmacokinetics in chronic renal failu.pdf:/home/shubhankar/Zotero/storage/CVQLLAVV/Jackson et al. - 1988 - Lisinopril pharmacokinetics in chronic renal failu.pdf:application/pdf},
