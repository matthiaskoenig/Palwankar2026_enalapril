	keywords = {Humans, *Thiophenes, Randomized Controlled Trials as Topic, Acrylates/adverse effects/*pharmacokinetics/*therapeutic use, Antihypertensive Agents/adverse effects/*pharmacokinetics/*therapeutic use, Imidazoles/adverse effects/*pharmacokinetics/*therapeutic use},
