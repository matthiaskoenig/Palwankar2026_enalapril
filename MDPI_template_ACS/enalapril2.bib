	doi = {10.1016/s0005-2736(98)00093-5},
	abstract = {We demonstrate that the angiotensin-converting enzyme inhibitors enalapril and captopril inhibit the transport of D-Phe-L-Gln into {PepT}1-expressing Xenopus  oocytes and into rat renal cortical brush border membrane vesicles ({BBMV}). The  kinetics of inhibition are competitive. Enalapril and captopril are not  substrates for {PepT}2 (Boll et al., Proc. Natl. Acad. Sci. 93 (1996) 284-289).  Therefore we conclude that in rat renal cortical {BBMV} this neutral dipeptide is  transported via {PepT}1.},
