	shortjournal = {Biochemistry (Mosc)},
	author = {Grinshtein, S. V. and Binevski, P. V. and Gomazkov, O. A. and Pozdnev, V. F. and Nikolskaya, I. I. and Kost, O. A.},
	date = {1999-08},
	note = {Place: United States},
	keywords = {Male, Animals, Kinetics, Structure-Activity Relationship, Peptidyl-Dipeptidase A/*metabolism, Angiotensin I/*metabolism, Captopril/pharmacology, Enalapril/pharmacology, Angiotensin-Converting Enzyme Inhibitors/*pharmacology, Dipeptides/*pharmacology, Lung/*enzymology, Substrate Specificity, Cattle, Kinins/*metabolism, Lisinopril/pharmacology, Testis/*enzymology},
