	keywords = {checked:{SP}, Male, Administration, Oral, Dose-Response Relationship, Drug, Animals, Enalapril/administration \& dosage/*pharmacokinetics, Rats, *Disease Models, Animal, Angiotensin I/administration \& dosage/adverse effects/antagonists \& inhibitors, Cardiomyopathy, Dilated/*drug therapy/physiopathology, Collagen Type {III}/antagonists \& inhibitors/genetics, Endomyocardial Fibrosis/genetics/metabolism, Gene Expression, Heart Failure/chemically induced/complications/drug therapy, Hemodynamics, Hypertension/chemically induced/complications/prevention \& control, Infusions, Intravenous, Pericardial Effusion, Perindopril/administration \& dosage/adverse effects/*pharmacokinetics, priority:no, Rats, Inbred Lew, {RNA}, Messenger/genetics/metabolism, Survival Rate, Time Factors, Transforming Growth Factor beta/antagonists \& inhibitors/genetics, Transforming Growth Factor beta1, Ventricular Dysfunction, Left/drug therapy/genetics, Ventricular Pressure},
	file = {Watanabe et al. - 2003 - Comparative Effects of Perindopril with Enalapril .pdf:/home/shubhankar/Zotero/storage/VAR9DQK5/Watanabe et al. - 2003 - Comparative Effects of Perindopril with Enalapril .pdf:application/pdf},
}

