	author = {Tarkiainen, E. Katriina and Tornio, Aleksi and Holmberg, Mikko T. and Launiainen, Terhi and Neuvonen, Pertti J. and Backman, Janne T. and Niemi, Mikko},
	date = {2015-11},
	note = {Place: England},
	keywords = {Adult, checked:{SP}, Cross-Over Studies, data:pharmacokinetics, data:timecourse, Humans, Male, priority:high, species:human, Blood Pressure/drug effects, checked:{MK}, data:pharmacodynamics, Female, enalapril, Heart Rate/drug effects, Genotype, Young Adult, Quinapril, {CES}1, Polymorphism, Single Nucleotide/*genetics, Enalaprilat/blood/urine, Healthy Volunteers, carboxylesterase, rs71647871, Angiotensin-Converting Enzyme Inhibitors/blood/pharmacokinetics/pharmacology/urine, Carboxylic Ester Hydrolases/*genetics, Enalapril/blood/*pharmacokinetics/pharmacology/urine, p.G143E, quinapril, Tetrahydroisoquinolines/blood/*pharmacokinetics/pharmacology/urine},
