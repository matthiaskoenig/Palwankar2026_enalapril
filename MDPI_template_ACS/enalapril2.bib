@article{Luo2015,
	title = {{SLCO}1B1 Variants and Angiotensin Converting Enzyme Inhibitor (Enalapril)-Induced Cough: a Pharmacogenetic Study.},
	volume = {5},
	issn = {2045-2322},
	doi = {10.1038/srep17253},
	abstract = {Clinical observations suggest that incidence of cough in Chinese taking angiotensin converting enzyme inhibitors is much higher than other racial groups.  Cough is the most common adverse reaction of enalapril. We investigate whether  {SLCO}1B1 genetic polymorphisms, previously reported to be important determinants  of inter-individual variability in enalapril pharmacokinetics, are associated  with the enalapril-induced cough. A cohort of 450 patients with essential  hypertension taking 10 mg enalapril maleate were genotyped for the functional  {SLCO}1B1 variants, 388A {\textgreater} G (Asn130Asp, rs2306283) and 521T {\textgreater} C (Val174Ala,  rs4149056). The primary endpoint was cough, which was recorded when participants  were bothered by cough and respiratory symptoms during enalapril treatment  without an identifiable cause. {SLCO}1B1 521C allele conferred a 2-fold relative  risk of enalapril-induced cough (95\% confidence interval [{CI}] = 1.34-3.04, P =  6.2 × 10(-4)), and haplotype analysis suggested the relative risk of cough was  6.94-fold (95\% {CI} = 1.30-37.07, P = 0.020) in {SLCO}1B1*15/*15 carriers.  Furthermore, there was strong evidence for a gene-dose effect (percent with cough  in those with 0, 1, or 2 copy of the 521C allele: 28.2\%, 42.5\%, and 71.4\%, trend  P = 6.6 × 10(-4)). Our study highlights, for the first time, {SLCO}1B1 variants are  strongly associated with an increased risk of enalapril-induced cough. The  findings will be useful to provide pharmacogenetic markers for enalapril  treatment.},
	pages = {17253},
	journaltitle = {Scientific reports},
	shortjournal = {Sci Rep},
	author = {Luo, Jian-Quan and He, Fa-Zhong and Wang, Zhen-Min and Sun, Ning-Ling and Wang, Lu-Yan and Tang, Gen-Fu and Liu, Mou-Ze and Li, Qing and Chen, Xiao-Ping and Liu, Zhao-Qian and Zhou, Hong-Hao and Zhang, Wei},
	date = {2015-11-26},
	note = {Place: England},
	keywords = {checked:{SP}, Humans, Male, species:human, checked:{MK}, Female, Middle Aged, priority:no, Liver-Specific Organic Anion Transporter 1, Pharmacogenetics, *Genetic Predisposition to Disease, Angiotensin-Converting Enzyme Inhibitors/*adverse effects, Cough/*chemically induced, Enalapril/*adverse effects, Gene Dosage, Haplotypes/genetics, Linkage Disequilibrium/genetics, Organic Anion Transporters/*genetics, Polymorphism, Single Nucleotide/*genetics, Risk Factors},
	file = {Luo et al. - 2015 - SLCO1B1 Variants and Angiotensin Converting Enzyme.pdf:/home/shubhankar/Zotero/storage/6P99NLPI/Luo et al. - 2015 - SLCO1B1 Variants and Angiotensin Converting Enzyme.pdf:application/pdf},
}

@article{Lukawski2013,
	title = {Combined treatment with gabapentin and drugs affecting the renin-angiotensin system against electroconvulsions in mice.},
	volume = {706},
	rights = {Copyright © 2013 Elsevier B.V. All rights reserved.},
	issn = {1879-0712 0014-2999},
	doi = {10.1016/j.ejphar.2013.02.054},
	abstract = {Recent experimental data suggest that certain angiotensin-converting enzyme ({ACE}) inhibitors and angiotensin {AT}1 receptor antagonists may possess anticonvulsant  activity. The purpose of this study was to examine the effects of two {ACE}  inhibitors, captopril and enalapril, and two {AT}1 receptor antagonists, losartan  and telmisartan, on the protective action of gabapentin in the maximal  electroshock seizure threshold test in mice. Additionally, the effects of the  combined treatment with gabapentin and antihypertensive drugs on memory retention  in the passive avoidance task and motor coordination in the chimney test were  assessed. All drugs were injected intraperitoneally. Losartan (50mg/kg)  significantly increased the convulsive threshold for gabapentin. The other  antihypertensive drugs, captopril (50mg/kg), enalapril (30 mg/kg) and telmisartan  (30 mg/kg), did not affect the anticonvulsant activity of gabapentin. The  observed interaction between gabapentin and losartan could be pharmacokinetic in  nature. Losartan increased plasma and total brain concentrations of gabapentin.  In the chimney test, losartan (50mg/kg) administered with gabapentin (50mg/kg)  caused motor impairment. In the passive avoidance test, memory retention was not  affected by the combined treatment with gabapentin and antihypertensive drugs. It  is suggested that the use of captopril, enalapril and telmisartan in epileptic  patients receiving gabapentin is presumed neutral upon its anticonvulsant action.  The utmost caution is advised when combining losartan and gabapentin in clinical  practice due to the appearance of pharmacokinetic interactions between losartan  and gabapentin as well as motor impairment evoked by these drugs in mice.},
	pages = {92--97},
	number = {1},
	journaltitle = {European journal of pharmacology},
	shortjournal = {Eur J Pharmacol},
	author = {Lukawski, Krzysztof and Janowska, Agnieszka and Jakubus, Tomasz and Raszewski, Grzegorz and Czuczwar, Stanisław J.},
	date = {2013-04-15},
	note = {Place: Netherlands},
	keywords = {Male, Animals, Telmisartan, Drug Therapy, Combination, Electroshock, Mice, Amines/*administration \& dosage/blood/pharmacokinetics, Angiotensin {II} Type 1 Receptor Blockers/*administration \& dosage, Angiotensin-Converting Enzyme Inhibitors/*administration \& dosage, Anticonvulsants/*administration \& dosage/blood/pharmacokinetics, Avoidance Learning/drug effects, Benzimidazoles/administration \& dosage, Benzoates/administration \& dosage, Brain/metabolism, Captopril/administration \& dosage, Cyclohexanecarboxylic Acids/*administration \& dosage/blood/pharmacokinetics, Enalapril/administration \& dosage, Gabapentin, gamma-Aminobutyric Acid/*administration \& dosage/blood/pharmacokinetics, Losartan/administration \& dosage, Motor Skills/drug effects, Seizures/*drug therapy/physiopathology},
	file = {Łukawski et al. - 2013 - Combined treatment with gabapentin and drugs affec.pdf:/home/shubhankar/Zotero/storage/ZRS3YDN9/Łukawski et al. - 2013 - Combined treatment with gabapentin and drugs affec.pdf:application/pdf},
}

@article{Louis1992,
	title = {Comparison of the pharmacokinetics and pharmacodynamics of perindopril, cilazapril and enalapril.},
	volume = {19},
	issn = {0143-9294},
	doi = {10.1111/j.1440-1681.1992.tb02811.x},
	abstract = {1. The pharmacokinetic and pharmacodynamic responses to enalapril, perindopril and cilazapril have been studied in essential hypertensives (2, 4 and 8 mg  perindopril and 2.5 mg cilazapril, single dose and steady state) and normotensive  volunteers (10 mg enalapril, single dose). 2. Plasma levels of the active diacid  compounds reached similar peaks after single dose administration of the drugs.  However, perindoprilat levels persisted for 5 days whereas cilazaprilat levels  were not detectable beyond 12 h. 3. The higher levels of perindoprilat were  associated with a greater inhibition of plasma angiotensin-converting enzyme  ({ACE}) activity in both acute and steady state studies. 4. The potency of the  active diacids in inhibiting plasma {ACE} activity was perindoprilat greater than  cilazaprilat greater than enalaprilat. 5. There was a close relationship between  plasma concentration, {ACE} inhibition and blood pressure decrease. Although both  cilazapril and perindopril administration reduced blood pressure in hypertensive  subjects, only perindopril exerted 24 h blood pressure control at the doses used.},
	pages = {55--60},
	journaltitle = {Clinical and experimental pharmacology \& physiology. Supplement},
	shortjournal = {Clin Exp Pharmacol Physiol Suppl},
	author = {Louis, W. J. and Conway, E. L. and Krum, H. and Workman, B. and Drummer, O. H. and Lam, W. and Phillips, P. and Howes, L. G. and Jackson, B.},
	date = {1992},
	note = {Place: Australia},
	keywords = {Adult, checked:{SP}, data:pharmacokinetics, data:timecourse, Humans, Male, species:human, Aged, Blood Pressure/drug effects, data:pharmacodynamics, Female, Peptidyl-Dipeptidase A/blood, Half-Life, priority:low, Middle Aged, Perindopril, Angiotensin-Converting Enzyme Inhibitors/*pharmacokinetics/*pharmacology, Cilazapril/blood/*pharmacokinetics/pharmacology, Enalapril/blood/*pharmacokinetics/pharmacology, Indoles/blood/*pharmacokinetics/pharmacology, Random Allocation},
	file = {Louis et al. - 1992 - COMPARISON OF THE PHARMACOKINETICS AND PHARMACODYN.pdf:/home/shubhankar/Zotero/storage/X8KRYEC7/Louis et al. - 1992 - COMPARISON OF THE PHARMACOKINETICS AND PHARMACODYN.pdf:application/pdf},
