	keywords = {Adult, checked:{SP}, data:pharmacokinetics, data:timecourse, Humans, Male, priority:high, species:human, data:pharmacodynamics, Enalapril, Lisinopril, Renin-Angiotensin System, Angiotensins, Angiotensin-Converting Enzyme Inhibitors, Captopril, Dipeptides},
	file = {Biollaz et al_1982_Enalapril maleate and a lysine analogue (MK-521) in normal volunteers\;.pdf:/home/shubhankar/Zotero/storage/KW2RRNR6/Biollaz et al_1982_Enalapril maleate and a lysine analogue (MK-521) in normal volunteers\;.pdf:application/pdf},
