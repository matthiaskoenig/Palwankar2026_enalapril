@article{Saadah2020,
	title = {Carnosine to Combat Novel Coronavirus ({nCoV}): Molecular Docking and Modeling to Cocrystallized Host Angiotensin-Converting Enzyme 2 ({ACE}2) and Viral Spike  Protein.},
	volume = {25},
	issn = {1420-3049},
	doi = {10.3390/molecules25235605},
	abstract = {{AIMS}: Angiotensin-converting enzyme 2 ({ACE}2) plays an important role in the entry of coronaviruses into host cells. The current paper described how carnosine, a  naturally occurring supplement, can be an effective drug candidate for  coronavirus disease ({COVID}-19) on the basis of molecular docking and modeling to  host {ACE}2 cocrystallized with {nCoV} spike protein. {METHODS}: First, the starting  point was {ACE}2 inhibitors and their structure-activity relationship ({SAR}). Next,  chemical similarity (or diversity) and {PubMed} searches made it possible to  repurpose and assess approved or experimental drugs for {COVID}-19. Parallel, at  all stages, the authors performed bioactivity scoring to assess potential  repurposed inhibitors at {ACE}2. Finally, investigators performed molecular docking  and modeling of the identified drug candidate to host {ACE}2 with {nCoV} spike  protein. {RESULTS}: Carnosine emerged as the best-known drug candidate to match  {ACE}2 inhibitor structure. Preliminary docking was more optimal to {ACE}2 than the  known typical angiotensin-converting enzyme 1 ({ACE}1) inhibitor (enalapril) and  quite comparable to known or presumed {ACE}2 inhibitors. Viral spike protein  elements binding to {ACE}2 were retained in the best carnosine pose in {SwissDock} at  1.75 Angstroms. Out of the three main areas of attachment expected to the  protein-protein structure, carnosine bound with higher affinity to two compared  to the known {ACE}2 active site. {LibDock} score was 92.40 for site 3, 90.88 for site  1, and inside the active site 85.49. {CONCLUSION}: Carnosine has promising  inhibitory interactions with host {ACE}2 and {nCoV} spike protein and hence could  offer a potential mitigating effect against the current {COVID}-19 pandemic.},
	number = {23},
	journaltitle = {Molecules (Basel, Switzerland)},
	shortjournal = {Molecules},
	author = {Saadah, Loai M. and Deiab, Ghina'a I. Abu and Al-Balas, Qosay and Basheti, Iman A.},
	date = {2020-11-28},
	note = {Place: Switzerland},
	keywords = {Humans, Biological Availability, Structure-Activity Relationship, Crystallization, molecular docking, Molecular Docking Simulation, Angiotensin-Converting Enzyme Inhibitors/chemistry/*pharmacology, modeling, Catalytic Domain, Antiviral Agents/pharmacology, {COVID}-19, angiotensin-converting enzyme 2 ({ACE}2), Angiotensin-Converting Enzyme 2/*antagonists \& inhibitors/*chemistry/metabolism, carnosine, Carnosine/chemistry/metabolism/pharmacology, {COVID}-19 Drug Treatment, practitioner, Protein Interaction Domains and Motifs/drug effects, Spike Glycoprotein, Coronavirus/chemistry/metabolism},
	file = {Saadah et al. - 2020 - Carnosine to Combat Novel Coronavirus (nCoV) Mole.pdf:/home/shubhankar/Zotero/storage/8FUJP35D/Saadah et al. - 2020 - Carnosine to Combat Novel Coronavirus (nCoV) Mole.pdf:application/pdf},
}

