@article{Perico2009,
	title = {V1/V2 Vasopressin receptor antagonism potentiates the renoprotection of renin-angiotensin system inhibition in rats with renal mass reduction.},
	volume = {76},
	issn = {1523-1755 0085-2538},
	doi = {10.1038/ki.2009.267},
	abstract = {Blockade of the renin-angiotensin system ({RAS}), the standard treatment for chronic proteinuric nephropathy, slows but may not halt progression of the  disease, particularly when therapy is started late. Because vasopressin may also  play a role in the progression of renal disease, we measured the effect of a dual  V(1a) and V(2) vasopressin receptor antagonist ({RWJ}-676070) alone or combined  with angiotensin-converting enzyme inhibition or angiotensin {II} type 1 receptor  blockade on proteinuria and renal disease progression during overt nephropathy.  Twenty-one days after renal mass reduction, a time of established injury, rats  were given vehicle, {RWJ}-676070, enalapril, losartan, {RWJ}-676070 plus enalapril,  or losartan in drinking water for an additional 39 days. {RWJ}-676070 returned the  blood pressure to pre-treatment levels, which were significantly lower than those  in vehicle-treated rats. Enalapril, losartan, and the combined therapies reduced  blood pressure to a greater extent. {RWJ}-676070 afforded a partial antiproteinuric  effect, which was enhanced by the addition of enalapril or losartan. Renal  functional impairment, and glomerular and tubular changes were partially  ameliorated by {RWJ}-676070; parameters significantly improved with either  enalapril or losartan alone and improved to a greater extent with the combined  therapies. Our findings suggest that vasopressin receptor antagonists could be of  additional therapeutic value in the treatment of chronic proteinuric nephropathy.},
	pages = {960--967},
	number = {9},
	journaltitle = {Kidney international},
	shortjournal = {Kidney Int},
	author = {Perico, Norberto and Zoja, Carla and Corna, Daniela and Rottoli, Daniela and Gaspari, Flavio and Haskell, Lloyd and Remuzzi, Giuseppe},
	date = {2009-11},
	note = {Place: United States},
	keywords = {Male, Blood Pressure/drug effects, Animals, Body Weight/drug effects, Rats, Time Factors, Disease Models, Animal, Drug Therapy, Combination, Chronic Disease, Rats, Sprague-Dawley, Eating/drug effects, Disease Progression, Angiotensin-Converting Enzyme Inhibitors/*pharmacology, Enalapril/*pharmacology, Diuresis/drug effects, Renin-Angiotensin System/*drug effects, *Antidiuretic Hormone Receptor Antagonists, Angiotensin {II} Type 1 Receptor Blockers/*pharmacology, Benzazepines/blood/pharmacokinetics/*pharmacology, Biomarkers/blood/urine, Drinking/drug effects, Hormone Antagonists/blood/pharmacokinetics/*pharmacology, Kidney Diseases/*drug therapy/metabolism/pathology/physiopathology, Kidney/*drug effects/metabolism/pathology/physiopathology, Losartan/*pharmacology, Nephrectomy, Proteinuria/drug therapy/metabolism, Receptors, Vasopressin/metabolism, Spiro Compounds/blood/pharmacokinetics/*pharmacology},
	file = {Perico et al. - 2009 - V1V2 Vasopressin receptor antagonism potentiates .pdf:/home/shubhankar/Zotero/storage/798IECYV/Perico et al. - 2009 - V1V2 Vasopressin receptor antagonism potentiates .pdf:application/pdf},
