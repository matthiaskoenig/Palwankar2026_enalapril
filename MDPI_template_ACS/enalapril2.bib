	keywords = {Adult, Area Under Curve, checked:{SP}, Cross-Over Studies, data:pharmacokinetics, data:timecourse, Humans, Male, priority:high, species:human, Therapeutic Equivalency, Female, Middle Aged, Drug Combinations, Antihypertensive Agents/blood/*pharmacokinetics, Electrocardiography/drug effects, Enalapril/blood/*pharmacokinetics, Hydrochlorothiazide/blood/*pharmacokinetics},
	file = {Niopas et al. - 2011 - Evaluation of the Bioequivalence of Two Tablet For.pdf:/home/shubhankar/Zotero/storage/DYIEHVVQ/Niopas et al. - 2011 - Evaluation of the Bioequivalence of Two Tablet For.pdf:application/pdf},
