  title = {The Pharmacokinetics of Lisinopril in Hospitalized Patients with Congestive Heart Failure.},
  author = {Till, A. E. and Dickstein, K. and Aarsland, T. and Gomez, H. J. and Gregg, H. and Hichens, M.},
