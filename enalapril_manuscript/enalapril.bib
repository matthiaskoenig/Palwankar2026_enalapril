  file = {/home/mkoenig/Zotero/storage/WB5UHAWV/Rotmensch et al. - 1988 - Angiotensin-Converting Enzyme Inhibitors.pdf}
}

@article{Rouini2002,
  title = {Relationship of Serum {{ACE}} Inhibition to Oral Dose of Enalapril in Normotensive Volunteers.},
  author = {Rouini, M. and Hamidi, M. and Ghayoumi, A. and Ismailpour, A.},
  date = {2002-04},
  journaltitle = {Journal of clinical pharmacy and therapeutics},
  shortjournal = {J Clin Pharm Ther},
  volume = {27},
  number = {2},
  eprint = {11975696},
  eprinttype = {pmid},
  pages = {121--126},
  location = {England},
  issn = {0269-4727},
  doi = {10.1046/j.1365-2710.2002.00390.x},
  abstract = {OBJECTIVES: To determine the relationship between oral dose of enalapril and parameters describing serum angiotensin converting enzyme (ACE) inhibition.  METHODS: Four different oral doses of enalapril maleate (2.5, 5, 10 and 20 mg)  were administered to six healthy normotensive volunteers, in a four-period  crossover study. Serum ACE inhibition profiles were determined in each case using  a synthetic substrate, hippuryl-histidyl-leucine (HHL). Pharmacodynamic  parameters of the drug (Emax and AUEC0--{$>$}24) were calculated and their  relationship to oral doses investigated using linear regression analysis.  RESULTS: There was no significant relationship between drug dose and the two  pharmacodynamic parameters (Emax and AUEC0--{$>$}24). The r2 values were 0.548  (F=3.63, P=0.153) and 0.6360 (F=5.24, P=0.106) for Emax and AUEC0--{$>$}24,  respectively. CONCLUSION: The extent of serum ACE inhibition, as the main  determinant of the blood pressure lowering effect of enalapril, is not  dose-dependent within the single dose range of 2.5-20 mg.},
  langid = {english},
  keywords = {Administration Oral,Adult,Angiotensin-Converting Enzyme Inhibitors/administration & dosage/*pharmacokinetics,Blood Pressure/drug effects,checked:SP,data:pharmacodynamics,data:pharmacokinetics,data:timecourse,Dose-Response Relationship Drug,Enalapril/administration & dosage/*pharmacokinetics,Humans,Hypertension/drug therapy,Male,Peptidyl-Dipeptidase A/*analysis,priority:high,species:human},
  file = {/home/mkoenig/Zotero/storage/8YCZ6EXN/Rouini et al. - 2002 - Relationship of serum ACE inhibition to oral dose .pdf}
}

