@article{Verbeeck2017,
  title = {Biowaiver {{Monographs}} for {{Immediate-Release Solid Oral Dosage Forms}}: {{Enalapril}}.},
  author = {Verbeeck, Roger K. and Kanfer, Isadore and Löbenberg, Raimar and Abrahamsson, Bertil and Cristofoletti, Rodrigo and Groot, D. W. and Langguth, Peter and Polli, James E. and Parr, Alan and Shah, Vinod P. and Mehta, Mehul and Dressman, Jennifer B.},
  date = {2017-08},
  journaltitle = {Journal of pharmaceutical sciences},
  shortjournal = {J Pharm Sci},
  volume = {106},
  number = {8},
  eprint = {28435140},
  eprinttype = {pmid},
  pages = {1933--1943},
  location = {United States},
  issn = {1520-6017 0022-3549},
  doi = {10.1016/j.xphs.2017.04.019},
  abstract = {Literature data relevant to the decision to allow a waiver of in~vivo bioequivalence testing for the marketing authorization of immediate-release,  solid oral dosage forms containing enalapril maleate are reviewed. Enalapril, a  prodrug, is hydrolyzed by carboxylesterases to the active angiotensin-converting  enzyme inhibitor enalaprilat. Enalapril as the maleate salt is shown to be highly  soluble, but only 60\%-70\% of an orally administered dose of enalapril is absorbed  from the gastrointestinal tract into the enterocytes. Consequently, enalapril  maleate is a Biopharmaceutics Classification System class III substance. Because  in situ conversion of the maleate salt to the sodium salt is sometimes used in  production of the finished drug product, not every enalapril maleate-labeled  finished product actually contains the maleate salt. Enalapril is not considered  to have a narrow therapeutic index. With this background, a biowaiver-based  approval procedure for new generic products or after major revisions to existing  products is deemed acceptable, provided the in~vitro dissolution of both test and  reference preparation is very rapid (at least 85\% within 15~min at pH 1.2, 4.5,  and 6.8). Additionally, the test and reference product must contain the identical  active drug ingredient.},
  langid = {english},
  keywords = {absorption,Administration Oral,Angiotensin-Converting Enzyme Inhibitors/*administration & dosage/chemistry/*pharmacokinetics,Biopharmaceutics Classification System (BCS),checked:MK,checked:SP,Drug Stability,enalapril maleate,Enalapril/*administration & dosage/chemistry/*pharmacokinetics,enalaprilat,Humans,in situ conversion,Intestinal Absorption,permeability,Permeability,priority:no,Prodrugs/administration & dosage/chemistry/pharmacokinetics,regulatory science,solubility,Solubility,Tablets,Therapeutic Equivalency},
  file = {/home/mkoenig/Zotero/storage/KZRQGI6R/Verbeeck et al. - 2017 - Biowaiver Monographs for Immediate-Release Solid O.pdf}
}

@article{Vertes1992,
  title = {Comparative Pharmacokinetics of Captopril, Enalapril, and Quinapril.},
  author = {Vertes, V. and Haynie, R.},
  date = {1992-04-02},
  journaltitle = {The American journal of cardiology},
  shortjournal = {Am J Cardiol},
  volume = {69},
  number = {10},
  eprint = {1546641},
  eprinttype = {pmid},
  pages = {8C-16C},
  location = {United States},
  issn = {0002-9149},
  doi = {10.1016/0002-9149(92)90276-5},
  abstract = {This review compares the metabolism and pharmacokinetic profiles of captopril, the first orally active angiotensin-converting enzyme (ACE) inhibitor, and 2  newer ACE inhibitors, enalapril and quinapril. Captopril differs from both  enalapril and quinapril in that its chemical structure contains a sulfhydryl  group, the presence of which may be important in the development of adverse  reactions. Captopril also differs from enalapril and quinapril in its ability to  be metabolized in plasma. Enalapril and quinapril are both de-esterified, most  likely in the liver, to their active metabolites, enalaprilat and quinaprilat.  All 3 ACE inhibitors are eliminated primarily via renal excretion, and renal  dysfunction markedly increases the area under the time versus plasma  concentration curves. Hepatic dysfunction also slows the conversion of enalapril  and quinapril to their active metabolites. There is evidence that both captopril  and enalapril, but not quinapril, may accumulate with repeated dosing. The  pharmacokinetics of these agents are not significantly modified by  co-administration of other drugs. However, captopril does cause marked increases  in trough plasma levels of digoxin. Overall, the pharmacokinetic profiles of  captopril, enalapril, and quinapril make them suitable for a wide range of  patients with hypertension or congestive heart failure.},
  langid = {english},
  keywords = {*Tetrahydroisoquinolines,Angiotensin-Converting Enzyme Inhibitors/*pharmacokinetics,Captopril/pharmacokinetics,checked:MK,checked:SP,data:pharmacokinetics,data:timecourse,Enalapril/pharmacokinetics,Humans,Hypertension/metabolism,Isoquinolines/pharmacokinetics,priority:high,Quinapril,Reference Values,review,species:human},
  file = {/home/mkoenig/Zotero/storage/LFVPYXVC/Vertes and Haynie - 1992 - Comparative pharmacokinetics of captopril, enalapr.pdf}
}

