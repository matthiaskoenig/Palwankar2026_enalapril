@article{Ulm1982,
  title = {Enalapril Maleate and a Lysine Analogue ({{MK-521}}): Disposition in Man.},
  author = {Ulm, E. H. and Hichens, M. and Gomez, H. J. and Till, A. E. and Hand, E. and Vassil, T. C. and Biollaz, J. and Brunner, H. R. and Schelling, J. L.},
  date = {1982-09},
  journaltitle = {British journal of clinical pharmacology},
  shortjournal = {Br J Clin Pharmacol},
  volume = {14},
  number = {3},
  eprint = {6289858},
  eprinttype = {pmid},
  pages = {357--362},
  location = {England},
  issn = {0306-5251 1365-2125},
  doi = {10.1111/j.1365-2125.1982.tb01991.x},
  abstract = {1 The disposition of two angiotensin converting-enzyme inhibitor drugs was studied in normal volunteers. One drug was enalapril maleate (MK-421), which  requires in vivo esterolysis to yield active inhibitor (MK-422). The other was a  lysine analogue of MK-422 (MK-521), which requires no bioactivation. 2 Absorption  of enalapril maleate (10 mg, p.o.) was rapid, with peak serum concentrations of  enalapril observed 0.5-1.5 h after administration. Based upon urinary recovery of  total drug (enalapril plus MK-422), absorption was at least 61\%. Bioactivation  appeared to be largely post-absorptive. From the ratio of MK-422 to total drug in  urine, the minimum extent of bioactivation was estimated at 0.7. 3 A similar dose  of MK-521 was absorbed more slowly, reaching peak serum concentrations 6-8 h  following drug administration. Minimum absorption, based upon urinary recovery,  was 29\%. 4 Serum concentration v time profiles for both drugs were polyphasic and  exhibited prolonged terminal phases. 5 Recovery in urine and faeces of  administered enalapril maleate (intact and as MK-422) was 94\%. Recovery of MK-521  was 97\%. These results indicate lack of significant metabolism of these agents,  apart from the bioactivation of enalapril.},
  langid = {english},
  pmcid = {PMC1427630},
  keywords = {*Angiotensin-Converting Enzyme Inhibitors,Biotransformation,checked:SP,data:pharmacokinetics,data:timecourse,Dipeptides/*metabolism,Enalapril,Humans,Intestinal Absorption,Lisinopril,Male,priority:high},
  file = {/home/mkoenig/Zotero/storage/AL7N6DUA/Ulm et al. - 1982 - Enalapril maleate and a lysine analogue (MK-521) .pdf}
}

@article{Ulm1983,
