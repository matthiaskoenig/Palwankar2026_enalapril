@article{Lazebnik2009,
  title = {[Combination therapy of arterial hypertension combined with liver pathology. The place of angiotensin converting enzyme inhibitors].},
  author = {Lazebnik, L. B. and Komissarenko, I. A. and Mikheeva, O. M. and Drozdov, V. N. and Sil'vestrova, S. Iu and Petrakov, A. V.},
