@article{Proesmans1996,
  title = {Long-Term Therapy with Enalapril in Patients with Nephrotic-Range Proteinuria.},
  author = {Proesmans, W. and Wambeke, I. V. and Dyck, M. V.},
  date = {1996-10},
  journaltitle = {Pediatric nephrology (Berlin, Germany)},
  shortjournal = {Pediatr Nephrol},
  volume = {10},
  number = {5},
  eprint = {8897561},
  eprinttype = {pmid},
