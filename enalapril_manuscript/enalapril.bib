  author = {Lee, Heon-Woo and Park, Wan-Su and Cho, Sung-Hee and Kim, Min-Hwan and Seo, Ji-Hyung and Kim, Yong-Won and Kim, Sung-Su and Lee, Yong-Sup and Lee, Kyung-Tae},
  date = {2007-01-15},
  journaltitle = {Talanta},
  shortjournal = {Talanta},
