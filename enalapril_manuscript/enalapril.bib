  author = {Zapater, Pedro and Novalbos, Jesús and Gallego-Sandín, Sonia and Hernández, Flavia T. and Abad-Santos, Francisco},
  date = {2004-05},
  journaltitle = {Journal of cardiovascular pharmacology},
