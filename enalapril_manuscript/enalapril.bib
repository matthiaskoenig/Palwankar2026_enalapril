@article{Medvedev2014,
  title = {[Erythrocyte aggregation in patients with arterial hypertension and dyslipidemia treated with pravastatin].},
  author = {Medvedev, I. N. and Skoriatina, I. A.},
  date = {2014},
  journaltitle = {Klinicheskaia meditsina},
  shortjournal = {Klin Med (Mosk)},
  volume = {92},
