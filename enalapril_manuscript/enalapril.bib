  keywords = {*Angiotensin-Converting Enzyme Inhibitors,Adenylyl Cyclase Inhibitors,Animals,Bridged Bicyclo Compounds/*pharmacology,Bridged-Ring Compounds/*pharmacology,Captopril/pharmacology,Colforsin,Cyclic AMP/biosynthesis,Dipeptides/pharmacology,Diterpenes/pharmacology,Enalapril,Heart/drug effects,In Vitro Techniques,Kinetics,Lung/enzymology,Membranes/drug effects,Muscle Proteins/metabolism,Myocardium/metabolism,Peptidyl-Dipeptidase A/blood,Rabbits,Ramipril,Rats,Rats Inbred Strains}
}

@article{Mihaila2020,
  title = {Drugs {{Commonly Applied}} to {{Kidney Patients May Compromise Renal Tubular Uremic Toxins Excretion}}.},
  author = {Mihaila, Silvia M. and Faria, João and Stefens, Maurice F. J. and Stamatialis, Dimitrios and Verhaar, Marianne C. and Gerritsen, Karin G. F. and Masereeuw, Rosalinde},
  date = {2020-06-12},
  journaltitle = {Toxins},
  shortjournal = {Toxins (Basel)},
  volume = {12},
  number = {6},
  eprint = {32545617},
  eprinttype = {pmid},
  location = {Switzerland},
  issn = {2072-6651},
  doi = {10.3390/toxins12060391},
  abstract = {In chronic kidney disease (CKD), the secretion of uremic toxins is compromised leading to their accumulation in blood, which contributes to uremic  complications, in particular cardiovascular disease. Organic anion transporters  (OATs) are involved in the tubular secretion of protein-bound uremic toxins  (PBUTs). However, OATs also handle a wide range of drugs, including those used  for treatment of cardiovascular complications and their interaction with PBUTs is  unknown. The aim of this study was to investigate the interaction between  commonly prescribed drugs in CKD and endogenous PBUTs with respect to  OAT1-mediated uptake. We exposed a unique conditionally immortalized proximal  tubule cell line (ciPTEC) equipped with OAT1 to a panel of selected drugs,  including angiotensin-converting enzyme inhibitors (ACEIs: captopril,  enalaprilate, lisinopril), angiotensin receptor blockers (ARBs: losartan and  valsartan), furosemide and statins (pravastatin and simvastatin), and evaluated  the drug-interactions using an OAT1-mediated fluorescein assay. We show that  selected ARBs and furosemide significantly reduced fluorescein uptake, with the  highest potency for ARBs. This was exaggerated in presence of some PBUTs.  Selected ACEIs and statins had either no or a slight effect at supratherapeutic  concentrations on OAT1-mediated fluorescein uptake. In conclusion, we demonstrate  that PBUTs may compete with co-administrated drugs commonly used in CKD  management for renal OAT1 mediated secretion, thus potentially compromising the  residual renal function.},
  langid = {english},
  pmcid = {PMC7354492},
  keywords = {Angiotensin Receptor Antagonists/pharmacology,Angiotensin-Converting Enzyme Inhibitors/pharmacology,Cell Line,chronic kidney disease management,drug-toxin interaction,Furosemide/pharmacology,Humans,Kidney Tubules/*drug effects/metabolism/physiopathology,OAT1-mediated transport,Organic Anion Transport Protein 1/*metabolism,Prescription Drugs/metabolism/*pharmacology,protein-bound uremic toxins,Renal Elimination/*drug effects,Renal Insufficiency Chronic/blood/*drug therapy/physiopathology,Sodium Potassium Chloride Symporter Inhibitors/pharmacology,Toxins Biological/*blood,Uremia/blood/*drug therapy/physiopathology},
  file = {/home/mkoenig/Zotero/storage/3BCQ7M9K/Mihaila et al. - 2020 - Drugs Commonly Applied to Kidney Patients May Comp.pdf}
}

@article{Mikheeva2011,
  title = {[Pharmacokinetic and pharmacodynamic characteristics of antihypertensive drugs in the treatment of hypertensive patients with chronic diseases of the liver].},
  author = {Mikheeva, O. M. and Drozdov, V. N. and Komisarenko, I. A.},
  date = {2011},
  journaltitle = {Terapevticheskii arkhiv},
  shortjournal = {Ter Arkh},
  volume = {83},
  number = {12},
  eprint = {22416445},
  eprinttype = {pmid},
  pages = {49--55},
  location = {Russia (Federation)},
  issn = {0040-3660},
  abstract = {AIM: To determine optimal treatment of arterial hypertension (AH) in patients with hepatic cirrhosis (HC) basing on pharmacokinetic and pharmacodynamic  characteristics of angiotensin-converting enzyme (ACE) inhibitors and  beta-adrenoblockers (BAB). MATERIAL AND METHODS: A total of 360 patients with AH  of the second degree, steatosis and alcoholic HC of class A according to  Child-Pue participated in the study. The control group consisted of 120 patients  with peptic ulcer in remission and normal function of the liver. The patients'  treatment with enalapril (pharmacologically inactive prodrug), lisinopril  (biologically active substance), atenolol (hydrophilic drug) and metoprolol  (lipophylic drug) was analysed. RESULTS: Lisinopril showed a better hypotensive  effect than enalapril in AH patients with HC. BAB decreased blood pressure in all  hypertensive patients. Atenolol and metoprolol effectively reduced blood pressure  in 88.89\% patients with AH and HC. Bradycardia episodes in atenolol treatment  were observed in 14.4\% patients while in metoprolol treatment--in 22.2\% patients,  this evidencing for pronounced shifts in pharmacokinetic parameters of metoprolol  exposed to hepatic metabolism. CONCLUSION: Biological activity is an essential  criterion of choice of ACE inhibitor in patients with hepatic pathology.  Enalapril, for example, as a pharmacological inactive prodrug, is metabolized in  the liver to acquire activity, whereas lisinopril has a direct biological  activity and has, therefore, a stronger hypotensive action in AH patients with  HC. BAB should be selected by the ability to effectively control blood pressure  and heart rate without inducing bradycardia the appearance of which necessitates  correction of dose regimen with reduction of day dose.},
  langid = {russian},
  keywords = {*Adrenergic beta-Antagonists/pharmacokinetics/pharmacology/therapeutic use,*Angiotensin-Converting Enzyme Inhibitors/pharmacokinetics/pharmacology/therapeutic use,*Antihypertensive Agents/pharmacokinetics/pharmacology/therapeutic use,Blood Pressure/drug effects,Chronic Disease,Dose-Response Relationship Drug,Fatty Liver/*complications/metabolism,Humans,Hypertension/complications/*drug therapy/metabolism,Liver Cirrhosis/*complications/metabolism,Liver/metabolism,Middle Aged,Treatment Outcome}
}

