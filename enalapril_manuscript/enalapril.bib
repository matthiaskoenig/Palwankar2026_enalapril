@article{Unger1987,
  title = {Effect of Converting Enzyme Inhibitors on Tissue Converting Enzyme and Angiotensin {{II}}: Therapeutic Implications.},
  author = {Unger, T. and Ganten, D. and Lang, R. E.},
  date = {1987-04-24},
  journaltitle = {The American journal of cardiology},
  shortjournal = {Am J Cardiol},
  volume = {59},
