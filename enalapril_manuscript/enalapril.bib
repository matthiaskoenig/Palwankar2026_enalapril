@article{Beermann1989,
  title = {Pharmacokinetics of Lisinopril ({{IV}}/{{PO}}) in Healthy Volunteers.},
  author = {Beermann, B. and Till, A. E. and Gomez, H. J. and Hichens, M. and Bolognese, J. A. and Junggren, I.},
  year = {1989 Jul-Aug},
  journaltitle = {Biopharmaceutics \& drug disposition},
  shortjournal = {Biopharm Drug Dispos},
  volume = {10},
  number = {4},
  eprint = {2547465},
  eprinttype = {pmid},
  pages = {397--409},
  location = {England},
  issn = {0142-2782},
  doi = {10.1002/bdd.2510100407},
  abstract = {When three intravenous doses of lisinopril were administered to healthy volunteers, area under the curve (to infinity) vs dose was linear with a positive  intercept. Subtracting area under the extrapolated terminal phase of the serum  profile from zero to infinity retained the linear relationship, but shifted the  regression line to a zero intercept. It is postulated that the terminal phase  reflects binding of drug to angiotensin-converting enzyme (ACE). The half-life  for the terminal phase (approximately 40 h) was not predictive of steady-state  parameters when ten daily doses (q24h) of lisinopril were administered orally to  healthy volunteers. The mean effective half-life for accumulation was 12.6 h. The  mean accumulation ratio was 1.38. Steady state was attained after the second  daily dose. The observations in these studies with lisinopril are similar to  those reported for enalaprilat, the active metabolite of the ACE inhibitor,  enalapril maleate.},
  langid = {english},
  keywords = {Administration Oral,Adult,Angiotensin-Converting Enzyme Inhibitors/administration & dosage/blood/*pharmacokinetics,Enalapril/administration & dosage/*analogs & derivatives/blood/pharmacokinetics,Humans,Injections Intravenous,Lisinopril,Male,Reference Values},
  file = {/home/mkoenig/Zotero/storage/UX6SZA3S/Beermann et al. - 1989 - Pharmacokinetics of lisinopril (IVPO) in healthy .pdf}
}

