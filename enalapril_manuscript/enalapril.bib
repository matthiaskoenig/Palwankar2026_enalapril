  author = {family=Broek, given=S. A., prefix=van den, useprefix=true and family=Bruggen, given=A., prefix=van, useprefix=true and family=Graeff, given=P. A., prefix=de, useprefix=true and Hillege, H. and family=Gilst, given=W. H., prefix=van, useprefix=true and Wesseling, H. and Lie, K. I.},
  date = {1991-10},
  journaltitle = {Journal of cardiovascular pharmacology},
  shortjournal = {J Cardiovasc Pharmacol},
