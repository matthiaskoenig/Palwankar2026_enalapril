  title = {{{SK}}\&{{F}} 87516, a Close Analog of Fenoldopam, Is a Partial Agonist at Dopamine-1 and Alpha-2 Receptors and Produces Stimulation of 5-Hydroxytryptamine-2 Receptors in  the Cardiovascular System of the Rat.},
  author = {Le Monnier de Gouville, A. C. and Lawson, K. and Thiry, C. and Cavero, I.},
